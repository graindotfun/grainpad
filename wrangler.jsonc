{
  "name": "grainpad-local",
  "main": "./worker.ts",
  "triggers": {"crons": ["* * * * *"]},
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grainpad-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "grainpad-local"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
